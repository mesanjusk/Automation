# ============================================================================
# Browser Automation OS — environment variables
# Copy to .env (root, for docker-compose) and/or apps/web/.env.local and
# apps/worker/.env as appropriate. Never commit real secrets.
# ============================================================================

# --- Core services ----------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/browser_automation_os
REDIS_URL=redis://localhost:6379

# --- AI (Gemini) -------------------------------------------------------------
GEMINI_API_KEY=
# Preferred deployment variable names. The app also accepts the legacy
# GEMINI_MODEL / GEMINI_VISION_MODEL names for backwards compatibility.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_MODEL=
# GEMINI_VISION_MODEL=
MAX_AI_ACTIONS=100
AI_ALLOWED_DOMAINS=

# --- File storage -------------------------------------------------------------
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_STORAGE_DIR=./storage/local

# --- Security ------------------------------------------------------------------
# 32-byte (64 hex char) key used for AES-256-GCM encryption of credentials,
# cookies and storage state. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Web <-> Worker wiring -------------------------------------------------
API_BASE_URL=http://localhost:3000
WORKER_PORT=4000
WORKER_ID=worker-1
# Worker /health endpoint the dashboard polls for the "Worker status" card,
# e.g. https://browser-automation-worker.onrender.com/health
WORKER_HEALTH_URL=http://localhost:4000/health
# Reserved for a future push-based worker->web callback channel. The current
# architecture doesn't need it (worker persists to MongoDB directly and
# delivers CRM callbacks via the webhooks queue).
WORKER_CALLBACK_URL=http://localhost:3000/api/internal/worker-callback

# --- Public API (used by external systems e.g. a CRM) -----------------------
# API keys are created from the dashboard; this is only a bootstrap key for
# local development / seeding.
BOOTSTRAP_API_KEY=

# --- CRM integration (generic, no vendor hard-coded) -------------------------
DEFAULT_CRM_WEBHOOK_URL=

# --- Browser -----------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
BROWSER_MAX_CONCURRENCY=3

# --- Test site (local, for e2e demo automation only) -------------------------
TEST_SITE_PORT=4100
TEST_SITE_URL=http://localhost:4100